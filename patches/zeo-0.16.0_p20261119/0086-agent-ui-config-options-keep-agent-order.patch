From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucascouts <lucascs@protonmail.com>
Date: Mon, 9 Nov 2026 22:53:01 -0300
Subject: [PATCH] agent_ui: the composer row keeps the agent's config option
 order

Zed 483b746b reversed the composer's config option row
(`self.selectors.iter().rev()`, "so the first one sits next to the send
button"). Claude Agent (Plus) sends Mode first, so Zeo 0.9.0_p20261109 drew
Mode last, beside Send, and the operator read every selector as moved
(2026-11-09). This keeps the agent's order, left to right, as every Zeo
before that snapshot drew it.

The order now lives in `selectors_in_composer_order`, which render uses and
the test reads: `composer_row_keeps_the_agents_option_order` builds a view
with mode, effort and model and expects them in that order. Seen failing
first, with ["model", "effort", "mode"].

Zeo 0.16.0_p20261119 (Zed 7279c76e): upstream df1ba676 removed the
reversal this patch undid. The row is now a fixed category order --
Mode, then Model -- with speed and effort drawn apart, so Mode is
leftmost whatever order the agent sends. What is left here is
selectors_in_composer_order (the row without the response controls) and
its test, expecting [mode, model]: a guard on the operator's 2026-11-09
ask, with no behaviour of its own. Candidate for retirement.
---

diff --git a/crates/agent_ui/src/config_options.rs b/crates/agent_ui/src/config_options.rs
index 219f1cb..3bd7567 100644
--- a/crates/agent_ui/src/config_options.rs
+++ b/crates/agent_ui/src/config_options.rs
@@ -527,12 +527,23 @@ impl Render for ConfigOptionsView {
             .when(self.has_overflow, |this| {
                 this.child(self.render_overflow_menu(cx))
             })
-            .children(
-                self.selectors
-                    .iter()
-                    .filter(|selector| !selector.read(cx).is_response_control)
-                    .cloned(),
-            )
+            .children(self.selectors_in_composer_order(cx))
+    }
+}
+
+impl ConfigOptionsView {
+    /// The selectors left to right as the composer row draws them: all but the
+    /// response controls (speed, effort), which sit at the composer's other end.
+    fn selectors_in_composer_order(&self, cx: &App) -> Vec<Entity<ConfigOptionSelector>> {
+        // Zed 483b746 reversed the row so the agent's first option sat next to Send; Claude
+        // Agent (Plus) sends Mode first, so Zeo drew it last (operator, 2026-11-09). Zed
+        // df1ba676 replaced the reversal with a fixed category order that already puts Mode
+        // left of Model; this keeps that order guarded.
+        self.selectors
+            .iter()
+            .filter(|selector| !selector.read(cx).is_response_control)
+            .cloned()
+            .collect()
     }
 }
 
@@ -2113,6 +2124,53 @@ mod tests {
         );
     }
 
+    // Zeo 0.9.1: Claude Agent's Mode is leftmost in the composer row. Since Zed df1ba676 the
+    // row is Mode then Model whatever order the agent sends, and effort sits apart.
+    #[gpui::test]
+    fn composer_row_keeps_the_agents_option_order(cx: &mut TestAppContext) {
+        cx.update(|cx| {
+            let settings_store = SettingsStore::test(cx);
+            cx.set_global(settings_store);
+            theme_settings::init(theme::LoadThemes::JustBase, cx);
+            editor::init(cx);
+        });
+        let select = |id: &'static str, category: acp::SessionConfigOptionCategory| {
+            acp::SessionConfigOption::select(
+                id,
+                id,
+                "a",
+                vec![
+                    acp::SessionConfigSelectOption::new("a", "A"),
+                    acp::SessionConfigSelectOption::new("b", "B"),
+                ],
+            )
+            .category(category)
+        };
+        let config_options = Rc::new(TestSessionConfigOptions::new(vec![
+            select("mode", acp::SessionConfigOptionCategory::Mode),
+            select("effort", acp::SessionConfigOptionCategory::ThoughtLevel),
+            select("model", acp::SessionConfigOptionCategory::Model),
+        ]));
+        let agent_server = Rc::new(TestAgentServer::default());
+        let fs: Arc<dyn Fs> = FakeFs::new(cx.executor());
+        let cx = cx.add_empty_window();
+        let view = cx.update(|window, cx| {
+            let config_options: Rc<dyn AgentSessionConfigOptions> = config_options.clone();
+            let agent_server: Rc<dyn AgentServer> = agent_server.clone();
+            cx.new(|cx| ConfigOptionsView::new(config_options, agent_server, fs, window, cx))
+        });
+
+        let drawn: Vec<String> = cx.update(|_, cx| {
+            let view = view.read(cx);
+            view.selectors_in_composer_order(cx)
+                .iter()
+                .map(|selector| selector.read(cx).config_id.0.to_string())
+                .collect()
+        });
+
+        assert_eq!(drawn, ["mode", "model"]);
+    }
+
     #[gpui::test]
     fn toggling_category_picker_without_select_config_option_is_unhandled(cx: &mut TestAppContext) {
         let agent_server = Rc::new(TestAgentServer::default());
